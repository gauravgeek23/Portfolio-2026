---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { title, period, summary, cover, coverAlt } = project.data;
const href = `${import.meta.env.BASE_URL}work/${project.id}/`;
---

<article class="project">
  <a class="cover" href={href} aria-label={`${title} case study`}>
    <Image src={cover} alt={coverAlt} widths={[400, 800]} sizes="(max-width: 832px) 100vw, 800px" />
  </a>
  <div class="meta">
    <div class="heading">
      <h3 class="text-medium"><a href={href}>{title}</a></h3>
      <p class="text-small text-muted">{period}</p>
    </div>
    <p class="text-small text-muted summary">{summary}</p>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cover {
    display: block;
    aspect-ratio: 2 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .cover:hover img {
    transform: scale(1.02);
  }
  .meta {
    display: flex;
    gap: 20px;
  }
  .heading {
    flex: 0 0 240px;
  }
  h3 {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .summary {
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
  }
  @media (max-width: 640px) {
    .meta {
      flex-direction: column;
      gap: 8px;
    }
    .heading {
      flex-basis: auto;
    }
  }
</style>
