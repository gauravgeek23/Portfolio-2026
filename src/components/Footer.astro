---
import Ruler from './Ruler.astro';
import Contact from './Contact.astro';
import { site } from '../data/site';
---

<footer class="footer">
  <div class="container stack">
    <div>
      <hr class="divider" />
      <Ruler />
    </div>
    <Contact />
  </div>
  <div class="wordmark" aria-hidden="true">
    <span>{site.name}</span>
  </div>
</footer>

<style>
  .footer {
    overflow: hidden;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  /* Oversized name cropped by the bottom edge of the page, fading from grey to white. */
  /* Figma: 180px text in a 220px line box, cropped after 149px, starting 13px above the links' baseline row. */
  .wordmark {
    --wordmark-size: min(180px, 12.5vw);
    display: flex;
    justify-content: center;
    height: calc(var(--wordmark-size) * 149 / 180);
    margin-top: calc(var(--wordmark-size) * -13 / 180);
    overflow: hidden;
    font-size: var(--wordmark-size);
  }
  .wordmark span {
    font-weight: 700;
    line-height: calc(220 / 180);
    letter-spacing: 0.01em;
    white-space: nowrap;
    background: linear-gradient(to bottom, var(--color-grey-2), var(--color-white));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }
  @media (max-width: 640px) {
    .stack {
      gap: 40px;
    }
    .wordmark {
      margin-top: 16px;
    }
  }
</style>
