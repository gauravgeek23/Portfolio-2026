---
import { Image } from 'astro:assets';
import arrowDown from '../assets/icons/arrow-down.svg';

interface Props {
  title: string;
  subtitle: string;
  id: string;
}

const { title, subtitle, id } = Astro.props;
---

<header class="section-header">
  <h2 class="title text-medium" id={id}>
    {title}
    <Image src={arrowDown} alt="" width={20} height={20} class="icon" loading="eager" />
  </h2>
  <p class="text-small text-muted">{subtitle}</p>
</header>

<style>
  .title {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }
  .icon {
    width: 20px;
    height: 20px;
  }
</style>
