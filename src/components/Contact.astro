---
import { Image } from 'astro:assets';
import arrowUpRight from '../assets/icons/arrow-up-right.png';
import { site } from '../data/site';

// Server-rendered fallback; the inline script below keeps the clock live.
const now = new Date();
const timeFormat: Intl.DateTimeFormatOptions = {
  timeZone: site.location.timeZone,
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hourCycle: 'h23',
};
const dateFormat: Intl.DateTimeFormatOptions = {
  timeZone: site.location.timeZone,
  weekday: 'long',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
};
const time = now.toLocaleTimeString('en-US', timeFormat);
const date = now.toLocaleDateString('en-US', dateFormat);
---

<section class="contact" aria-labelledby="contact-title">
  <div class="grid">
    <h2 class="text-medium" id="contact-title">
      Let's Build Something<br />Meaningful Together
    </h2>
    <div class="text-muted" data-clock data-tz={site.location.timeZone}>
      <p><time data-time>{time}</time><span class="visually-hidden"> in {site.location.city}</span></p>
      <p data-date>{date}</p>
    </div>
    <address class="text-muted">
      <p>{site.location.city}</p>
      <p>{site.location.region}</p>
    </address>
  </div>

  <div class="links">
    <p class="mail">
      <span class="text-medium">Mail to</span>
      <a class="text-muted" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <ul>
      {
        site.socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="noopener" class="text-medium">
              {social.label}
              <Image src={arrowUpRight} alt="" width={20} height={20} class="icon" loading="eager" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const timeZone = clock.dataset.tz;
    const timeEl = clock.querySelector('[data-time]')!;
    const dateEl = clock.querySelector('[data-date]')!;
    const tick = () => {
      const now = new Date();
      timeEl.textContent = now.toLocaleTimeString('en-US', {
        timeZone,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hourCycle: 'h23',
      });
      dateEl.textContent = now.toLocaleDateString('en-US', {
        timeZone,
        weekday: 'long',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
  }
  h2 {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }
  address {
    font-style: normal;
  }
  [data-time] {
    font-variant-numeric: tabular-nums;
  }
  .links {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .mail {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .mail a {
    text-decoration: none;
  }
  .mail a:hover {
    text-decoration: underline;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 42px;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    white-space: nowrap;
  }
  ul a:hover {
    text-decoration: underline;
  }
  .icon {
    width: 20px;
    height: 20px;
    transition: transform 200ms ease;
  }
  ul a:hover .icon {
    transform: translate(2px, -2px);
  }

  @media (max-width: 860px) {
    .links {
      flex-direction: column;
    }
    ul {
      flex-wrap: wrap;
      gap: 12px 32px;
    }
  }
  @media (max-width: 640px) {
    .contact {
      gap: 40px;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .grid h2 {
      grid-column: 1 / -1;
    }
    ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
