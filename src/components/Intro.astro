---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { site } from '../data/site';
---

<section class="intro">
  <div class="avatar">
    <Image src={avatar} alt={`Portrait of ${site.name}`} width={52} height={52} loading="eager" />
  </div>
  <div>
    <h1 class="text-medium">{site.name}</h1>
    <p class="text-muted">{site.role}</p>
  </div>
  <div class="text-small bio">
    <p class="text-muted">
      Business-driven Product Designer with 5 years of E2E ownership, translating complex business
      challenges into impactful experiences that drive measurable growth.
    </p>
    <p>
      In 2026, led design for growth initiatives at a $45M+ business reshaping India’s engineering
      education landscape.
    </p>
  </div>
</section>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .avatar {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-white);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h1 {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }
</style>
