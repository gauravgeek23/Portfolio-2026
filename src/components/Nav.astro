---
import { navItems, type NavId } from '../data/nav';

interface Props {
  active: NavId;
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="nav">
  <nav class="container inner" aria-label="Main">
    <a class="logo" href={base} aria-label="Gaurav Kumar, home">gk<span class="dot">.</span></a>
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={`${base}${item.href}`}
              class:list={['link', { active: item.id === active }]}
              aria-current={item.id === active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    background: rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: blur(32px);
    backdrop-filter: blur(32px);
  }
  .inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }
  /* Dashed rule under the nav, aligned with the 800px content column. */
  .inner::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-top: 1px dashed var(--color-grey-2);
  }
  .logo {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-black);
  }
  .dot {
    color: var(--color-accent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 24px;
  }
  .link {
    text-decoration: none;
    color: var(--color-grey-1);
  }
  .link:hover {
    color: var(--color-black);
  }
  .link.active {
    color: var(--color-black);
    font-weight: var(--weight-medium);
  }
  @media (max-width: 400px) {
    .inner,
    ul {
      gap: 16px;
    }
  }
</style>
