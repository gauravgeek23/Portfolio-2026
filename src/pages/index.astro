---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SideProjectCard from '../components/SideProjectCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { testimonials } from '../data/testimonials';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const side = (await getCollection('side')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout active="work">
  <main class="container page">
    <Intro />

    <hr class="divider" />

    <section class="stack" aria-labelledby="work">
      <SectionHeader id="work" title="Selected work" subtitle="Reach out for more details" />
      <div class="stack work-list">
        {work.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <hr class="divider" />

    <section class="stack" aria-labelledby="side-projects">
      <SectionHeader id="side-projects" title="Side projects" subtitle="Some actions in pursuit of passion" />
      <div class="side-grid">
        {side.map((project) => <SideProjectCard project={project} />)}
      </div>
    </section>

    <hr class="divider" />

    <section class="stack" aria-labelledby="testimonials">
      <SectionHeader id="testimonials" title="Testimonials" subtitle="Covers the boss and the crew" />
      <div class="carousel" tabindex="0" aria-label="Testimonials, scroll horizontally for more">
        {testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    padding-block: 120px 60px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }
  .work-list {
    gap: 80px;
  }
  .side-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 60px;
  }

  /* Testimonials scroll horizontally past the 800px column, as in the design. */
  .carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(370px, 85%);
    align-items: start;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .carousel::-webkit-scrollbar {
    display: none;
  }
  .carousel > :global(*) {
    scroll-snap-align: start;
  }

  @media (max-width: 640px) {
    .page {
      padding-block: 100px 40px;
      gap: 48px;
    }
    .work-list {
      gap: 56px;
    }
    .stack {
      gap: 40px;
    }
    .side-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
