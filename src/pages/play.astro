---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TabPlaceholder from '../components/TabPlaceholder.astro';
import SideProjectCard from '../components/SideProjectCard.astro';
import { site } from '../data/site';

const side = (await getCollection('side')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout active="play" title={`Play — ${site.name}`}>
  <TabPlaceholder title="Side projects" subtitle="Some actions in pursuit of passion">
    <div class="grid">
      {side.map((project) => <SideProjectCard project={project} />)}
    </div>
  </TabPlaceholder>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 60px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
